{
  "name": "nexq-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NexQ Web — a 100% browser-side DeepSeek client (React + TypeScript + Vite). No Tauri, no Rust, no backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:e2e": "node verification/verify-e2e.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
